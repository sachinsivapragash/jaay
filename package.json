{
  "name": "jaay",
  "version": "0.1.0",
  "description": "Point of sale and non-custodial Bitcoin wallet for market sellers in Dakar: CFA prices, signet on-chain + Lightning via Nostr Wallet Connect, credit book, AI helper.",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/client/main.js --bundle --format=esm --minify --sourcemap --target=es2020 --outfile=public/app.js",
    "start": "npm run build && node server.js",
    "dev": "npm run build && node --watch server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "@scure/btc-signer": "2.0.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "nostr-tools": "2.17.0",
    "qrcode-generator": "1.4.4"
  },
  "type": "module"
}